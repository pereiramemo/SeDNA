params {
    help             = false

    // Input mode selects which TSV samplesheet is used and how MODULE5 runs:
    //   from_fasta  - sample_name, fasta                  -> full pipeline
    //   from_annot  - sample_name, fasta, gff, domtblout  -> MODULE5 reuses a genome-wide
    //                                                        hmmsearch domtblout instead
    //                                                        of running pyHMMER
    input_mode = "from_fasta"

    from_fasta_tsv = './tests/data/from_fasta.tsv'
    from_annot_tsv = null

    nslots           = 8
    output_dir       = './tests/sedna-output/'
    full_output      = true
    // publishDir mode for every module: copy | symlink | rellink | link | move
    publish_mode     = "copy"
    // 1-6; modules 1-3 run side by side, so 1, 2 and 3 all mean "stop after BGC annotation"
    stop_at_module   = 6
    maxForks         = 3
    // Per-sample maxForks under -profile slurm. maxForks exists to protect a single
    // machine; on a cluster the scheduler does that job, so the per-process cap is
    // raised and executor.queueSize becomes the real pipeline-wide throttle.
    maxForks_slurm   = 30
    // Threads for the single-task, whole-dataset module 6.
    nslots_collected = 8

    // External databases. Not baked into the images: db_dir is bind-mounted into
    // MODULE1, MODULE2 and MODULE5*, so any of the paths below that is overridden
    // must still lie under db_dir. Left null, they resolve to <db_dir>/<name> at
    // task time, so a --db_dir given on the command line moves all three.
    // Populate with bin/download_dbs.py.
    db_dir       = "${System.getenv('HOME')}/.sedna/db"
    antismash_db = null   // <db_dir>/antismash
    deepbgc_db   = null   // <db_dir>/deepbgc/data
    pfam_hmm     = null   // <db_dir>/pfam/Pfam-A.hmm

    // MODULES 1-3
    skip_antismash   = false
    skip_deepbgc     = false
    skip_gecco       = false
    minlength        = 1000
    taxon            = "bacteria"
    genefinding_tool = "prodigal-m"
    deepbgc_score_thres     = 0.80
    deepbgc_cds_count_thres = 3
    gecco_score_thres       = 0.80
    gecco_cds_count_thres   = 3

    // MODULE4
    overlap_thres = 0.75
    synonyms_file = "${projectDir}/resources/bgc_class_synonyms.tsv"

    // MODULE5
    cds_id       = "locus_tag"
    evalue_thres = 1e-3
    cut_ga       = true

    // MODULE6
    embedding_method = "sif"
    birch_threshold  = 1.0
    alpha            = 0.001
    embeddings_file  = "${projectDir}/resources/embeddings/dom_embeddings_mtx_mibig_pfam.pkl"
    counts_file      = "${projectDir}/resources/embeddings/domain2counts_mibig3.1_vs_pfam.pkl"
}

process {
    // Per-sample modules: one task per sample, up to params.maxForks at a time,
    // each task using params.nslots threads. maxForks applies per process, not
    // pipeline-wide, so modules 1-3 overlap with each other and with 4-5.
    //
    // `memory` scales with task.attempt, which only ever exceeds 1 under
    // -profile slurm, where errorStrategy retries an OOM-killed task with a
    // bigger slice.
    //
    // containerOptions are closures so they read params.db_dir at task time,
    // after any --db_dir on the command line has been applied.
    withName: MODULE1 {
        maxForks = params.maxForks
        cpus     = params.nslots
        // antiSMASH --minimal: prodigal + hmmscan over the detection profiles.
        memory   = { 16.GB * task.attempt }
        containerOptions = { "--volume ${params.db_dir}:${params.db_dir}" }
    }
    withName: MODULE2 {
        maxForks = params.maxForks
        cpus     = params.nslots
        // deepBGC: prodigal + hmmscan vs its Pfam copy + TF1 BiLSTM.
        memory   = { 16.GB * task.attempt }
        containerOptions = { "--volume ${params.db_dir}:${params.db_dir}" }
    }
    withName: MODULE3 {
        maxForks = params.maxForks
        cpus     = params.nslots
        memory   = { 16.GB * task.attempt }
    }
    withName: MODULE4 {
        maxForks = params.maxForks
        cpus     = 1
        // Coordinate-only dereplication over small metadata tables.
        memory   = { 4.GB * task.attempt }
    }
    withName: /MODULE5.*/ {
        maxForks = params.maxForks
        cpus     = params.nslots
        // pyHMMER streams Pfam-A; per-BGC CDS sets are small.
        memory   = { 16.GB * task.attempt }
        containerOptions = { "--volume ${params.db_dir}:${params.db_dir}" }
    }

    // Whole-dataset module: a single task over all samples collected together,
    // so a separate budget of cpus is assigned (i.e., nslots_collected).
    withName: MODULE6 {
        maxForks = 1
        cpus     = params.nslots_collected
        // BIRCH over one 100-d vector per BGC.
        memory   = { 16.GB * task.attempt }
    }
}

profiles {

    // Default: single machine, Docker. Applied automatically when no -profile is given.
    standard {
        docker.enabled   = true
        process.executor = 'local'
    }

    // SLURM cluster with Apptainer.
    slurm {
        docker.enabled        = false   // also covers `-profile standard,slurm`
        apptainer.enabled     = true
        apptainer.cacheDir    = "${System.getenv('HOME')}/.sedna/apptainer"
        apptainer.pullTimeout = '2 h'

        process.executor = 'slurm'

        executor {
            // The scheduler does the queueing now, so per-process maxForks is no longer
            // the throttle -- queueSize caps how many jobs Nextflow keeps in flight.
            queueSize       = 50
            submitRateLimit = '10/1min'
        }

        process {
            // OOM (137) and walltime kills are the likeliest cluster failures; retry
            // with both a longer wall clock and more memory (task.attempt scales the
            // `memory` directives in the shared process block above).
            errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
            maxRetries    = 2
            time          = { 8.h * task.attempt }

            withName: MODULE3     { maxForks = params.maxForks_slurm }
            withName: MODULE4     { maxForks = params.maxForks_slurm }

            // --bind is the Apptainer equivalent of Docker's --volume;
            // "--bind <path>" binds path -> the same path inside the container. These
            // override the Docker-syntax containerOptions in the shared process block.
            withName: MODULE1 {
                maxForks = params.maxForks_slurm
                time     = { 24.h * task.attempt }
                containerOptions = { "--bind ${params.db_dir}" }
            }
            withName: MODULE2 {
                maxForks = params.maxForks_slurm
                time     = { 24.h * task.attempt }
                containerOptions = { "--bind ${params.db_dir}" }
            }
            withName: /MODULE5.*/ {
                maxForks = params.maxForks_slurm
                containerOptions = { "--bind ${params.db_dir}" }
            }
            withName: MODULE6 { time = { 24.h * task.attempt } }
        }
    }
}

workflow.onComplete = {
    if (!workflow.success) return

    def intermediateDir = new File("${params.output_dir}/intermediate/module-6")
    if (!intermediateDir.exists()) return // module 6 never ran (e.g. --stop_at_module < 6); nothing to link

    def workablesDir    = new File("${params.output_dir}/workables")
    workablesDir.mkdirs()

    def workablePatterns = [
        ~/bgc_clust-.*\.tsv(\.gz)?$/,
        ~/bgc_embeddings-.*\.tsv(\.gz)?$/,
    ]

    intermediateDir.eachFileRecurse { f ->
        if (!f.isFile()) return
        if (workablePatterns.any { pat -> f.name ==~ pat }) {
            def relTarget = workablesDir.toPath().relativize(f.toPath()).toString()
            def linkPath  = new File(workablesDir, f.name).toString()
            ["ln", "-sf", relTarget, linkPath].execute()
        }
    }
}
